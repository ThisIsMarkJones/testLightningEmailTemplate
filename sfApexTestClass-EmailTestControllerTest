@IsTest
private class EmailTestControllerTest {

    private static final String CONTACT_EMAIL = 'test@email.com';
    private static final String REVIEW_EMAIL = 'reviewer@company.com';

    @testSetup
    static void setupTestData() {
        Contact testContact = new Contact(
            FirstName = 'Test',
            LastName = 'Contact',
            Email = CONTACT_EMAIL
        );
        insert testContact;

        Account testAccount = new Account(Name = 'Test Account');
        insert testAccount;

        Opportunity testOpportunity = new Opportunity(
            Name = 'Test Opportunity',
            StageName = 'Prospecting',
            CloseDate = Date.today().addDays(30),
            AccountId = testAccount.Id
        );
        insert testOpportunity;

        Case testCase = new Case(
            Subject = 'Test Case Subject',
            Status = 'New',
            Origin = 'Phone',
            ContactId = testContact.Id,
            AccountId = testAccount.Id
        );
        insert testCase;

        Case caseWithoutContact = new Case(
            Subject = 'Case Without Contact',
            Status = 'New',
            Origin = 'Email',
            AccountId = testAccount.Id
        );
        insert caseWithoutContact;

        User runAsUser = [SELECT Id FROM User WHERE IsActive = true LIMIT 1];

        System.runAs(runAsUser) {
            insert new EmailTemplate(
                Name = 'Contact Lightning Template',
                DeveloperName = 'Contact_Lightning_Template',
                Subject = 'Hello {!Contact.FirstName}',
                HtmlValue = '<html><body>Hello {!Contact.FirstName}</body></html>',
                FolderId = UserInfo.getUserId(),
                TemplateType = 'custom',
                UiType = 'SFX',
                RelatedEntityType = 'Contact',
                IsActive = true
            );

            insert new EmailTemplate(
                Name = 'Case Lightning Template',
                DeveloperName = 'Case_Lightning_Template',
                Subject = 'Case {!Case.CaseNumber}',
                HtmlValue = '<html><body>Case {!Case.CaseNumber}</body></html>',
                FolderId = UserInfo.getUserId(),
                TemplateType = 'custom',
                UiType = 'SFX',
                RelatedEntityType = 'Case',
                IsActive = true
            );
        }
    }

    @IsTest
    static void testGetEmailTemplates() {
        Test.startTest();
        List<OptionWrapper> templates = EmailTestController.getEmailTemplates();
        Test.stopTest();

        System.assertNotEquals(null, templates, 'Templates list should not be null.');
        System.assert(templates.size() >= 2, 'Expected Lightning email templates to be returned.');

        Set<String> labels = new Set<String>();
        for (OptionWrapper item : templates) {
            labels.add(item.label);
        }

        System.assert(
            labels.contains('Contact Lightning Template'),
            'Contact template should be returned.'
        );
        System.assert(
            labels.contains('Case Lightning Template'),
            'Case template should be returned.'
        );
    }

    @IsTest
    static void testGetTargetObjectTypeForCaseTemplate() {
        EmailTemplate caseTemplate = [
            SELECT Id, RelatedEntityType
            FROM EmailTemplate
            WHERE DeveloperName = 'Case_Lightning_Template'
            LIMIT 1
        ];

        Test.startTest();
        String relatedType = EmailTestController.getTargetObjectType(caseTemplate.Id);
        Test.stopTest();

        System.assertEquals(
            'Case',
            relatedType,
            'RelatedEntityType should be Case.'
        );
    }

    @IsTest
    static void testGetRecordsForOpportunityUsesName() {
        Test.startTest();
        List<OptionWrapper> records = EmailTestController.getRecords('Opportunity');
        Test.stopTest();

        System.assertNotEquals(0, records.size(), 'Opportunity records should be returned.');
        System.assertEquals(
            'Test Opportunity',
            records[0].label,
            'Opportunity should use Name as the display label.'
        );
    }

    @IsTest
    static void testGetRecordsForCaseUsesCaseNumber() {
        Case existingCase = [
            SELECT Id, CaseNumber
            FROM Case
            WHERE Subject = 'Test Case Subject'
            LIMIT 1
        ];

        Test.startTest();
        List<OptionWrapper> records = EmailTestController.getRecords('Case');
        Test.stopTest();

        System.assertNotEquals(0, records.size(), 'Case records should be returned.');

        Boolean foundMatchingCase = false;
        for (OptionWrapper recordOption : records) {
            if (recordOption.value == existingCase.Id) {
                foundMatchingCase = true;
                System.assertEquals(
                    existingCase.CaseNumber,
                    recordOption.label,
                    'Case should use CaseNumber as the display label.'
                );
            }
        }

        System.assertEquals(
            true,
            foundMatchingCase,
            'The expected Case should be present in the returned options.'
        );
    }

    @IsTest
    static void testGetRecordsUnsupportedObjectThrowsHandledException() {
        Boolean exceptionThrown = false;

        Test.startTest();
        try {
            EmailTestController.getRecords('DefinitelyNotAnObject');
        } catch (AuraHandledException ex) {
            exceptionThrown = true;
            System.assert(
                ex.getMessage().contains('Unsupported object type'),
                'Expected unsupported object type message.'
            );
        }
        Test.stopTest();

        System.assertEquals(
            true,
            exceptionThrown,
            'An AuraHandledException should have been thrown.'
        );
    }

    @IsTest
    static void testSendTestEmailToContactRecord() {
        EmailTemplate contactTemplate = [
            SELECT Id
            FROM EmailTemplate
            WHERE DeveloperName = 'Contact_Lightning_Template'
            LIMIT 1
        ];

        Contact testContact = [
            SELECT Id, Email
            FROM Contact
            WHERE Email = :CONTACT_EMAIL
            LIMIT 1
        ];

        Test.startTest();
        EmailTestController.sendTestEmail(
            contactTemplate.Id,
            testContact.Id,
            testContact.Email
        );
        Integer emailInvocations = Limits.getEmailInvocations();
        Test.stopTest();

        System.assertEquals(
            1,
            emailInvocations,
            'One email invocation should occur for Contact send.'
        );
    }

    @IsTest
    static void testSendTestEmailToCaseRecordAllowsReviewerEmail() {
        EmailTemplate caseTemplate = [
            SELECT Id
            FROM EmailTemplate
            WHERE DeveloperName = 'Case_Lightning_Template'
            LIMIT 1
        ];

        Case testCase = [
            SELECT Id
            FROM Case
            WHERE Subject = 'Test Case Subject'
            LIMIT 1
        ];

        Test.startTest();
        EmailTestController.sendTestEmail(
            caseTemplate.Id,
            testCase.Id,
            REVIEW_EMAIL
        );
        Integer emailInvocations = Limits.getEmailInvocations();
        Test.stopTest();

        System.assertEquals(
            1,
            emailInvocations,
            'One email invocation should occur for Case send to a reviewer email.'
        );
    }

    @IsTest
    static void testSendTestEmailToCaseWithoutContactThrowsHandledException() {
        EmailTemplate caseTemplate = [
            SELECT Id
            FROM EmailTemplate
            WHERE DeveloperName = 'Case_Lightning_Template'
            LIMIT 1
        ];

        Case caseWithoutContact = [
            SELECT Id
            FROM Case
            WHERE Subject = 'Case Without Contact'
            LIMIT 1
        ];

        Boolean exceptionThrown = false;

        Test.startTest();
        try {
            EmailTestController.sendTestEmail(
                caseTemplate.Id,
                caseWithoutContact.Id,
                REVIEW_EMAIL
            );
        } catch (AuraHandledException ex) {
            exceptionThrown = true;
            System.assert(
                ex.getMessage().contains('does not have a Contact'),
                'Expected missing Case Contact message.'
            );
        }
        Test.stopTest();

        System.assertEquals(
            true,
            exceptionThrown,
            'An AuraHandledException should be thrown when the Case has no Contact.'
        );
    }
}
